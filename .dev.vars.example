# Beispiel für lokalen wrangler-Preview.
# Kopiere zu ".dev.vars" (im .gitignore) und fülle die Werte lokal aus.
# Für "npm run dev" (Next.js dev) nutzt Next stattdessen .env.local.

# Basic-Auth (Regel 5): nur online sinnvoll. Leer lassen = kein Schutz.
APP_PASSWORD=

# KI-Anbieter (spätere Phasen):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
# MONDAY_API_TOKEN=

# Cockpit 2027 (siehe docs/einrichtung-login-und-kunden.md)
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
# COCKPIT_ADMINS=
# CF_ACCOUNT_ID=
# CF_BROWSER_TOKEN=
# RESEND_API_KEY=
# MAIL_ABSENDER=
# TEAMS_WEBHOOK_URL=
# MONDAY_LIVE=
