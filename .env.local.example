# Vorlage für .env.local (lokal, für "npm run dev"). Kopieren nach .env.local und Werte eintragen.
# .env.local steht im .gitignore – NIE Schlüssel in Code, Chat oder Git.

# KI-Anbieter
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# monday.com (Serien-Anzeigen → „Spieltage nach monday übertragen“)
# Persönlicher API-Token: monday → Profilbild → Developers → My access tokens.
# Online stattdessen: npx wrangler secret put MONDAY_API_TOKEN
MONDAY_API_TOKEN=

# Basic-Auth (nur online sinnvoll; leer = kein Passwortschutz)
APP_PASSWORD=
