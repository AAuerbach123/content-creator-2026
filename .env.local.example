# Vorlage für .env.local (lokal, für "npm run dev"). Kopieren nach .env.local und Werte eintragen.
# .env.local steht im .gitignore – NIE Schlüssel in Code, Chat oder Git.

# KI-Anbieter
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# monday.com (Serien-Anzeigen → „Spieltage nach monday übertragen“)
# Persönlicher API-Token: monday → Profilbild → Developers → My access tokens.
# Online stattdessen: npx wrangler secret put MONDAY_API_TOKEN
MONDAY_API_TOKEN=

# Basic-Auth (nur online sinnvoll; leer = kein Passwortschutz)
APP_PASSWORD=

# ---- Cockpit 2027: Team, Kunden, monday (siehe docs/einrichtung-login-und-kunden.md) ----
# Anmeldung über Cloudflare Access (online). Lokal leer lassen = kein Login.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Komma-Liste: diese E-Mail-Adressen sind immer Admin
COCKPIT_ADMINS=
# Druck-PDFs online (Cloudflare Browser Rendering). Lokal wird Chrome auf dem Mac verwendet.
CF_ACCOUNT_ID=
CF_BROWSER_TOKEN=
# E-Mail-Benachrichtigungen (Resend). Leer = nur Glocke im Cockpit.
RESEND_API_KEY=
MAIL_ABSENDER=
# Microsoft Teams (freiwillig)
TEAMS_WEBHOOK_URL=
# monday: Schreiben in echte (nicht private, nicht „TEST“) Boards erst mit 1
MONDAY_LIVE=
